    <string name="onboarding_welcome_text_title">Selamat Datang</string>
    <string name="onboarding_welcome_text_paragraph">Terima kasih telah menginstal aplikasi saya! QuickWeather GRATIS dan Sumber Terbuka dan hanya tersedia di <a href="https://play.google.com/store/apps/details?id=com.ominous.quickweather">Google Play</a>, <a href="https://f-droid.org/en/packages/com.ominous.quickweather/">F-Droid</a>, dan <a href="https://github.com/TylerWilliamson/QuickWeather/releases">GitHub</a> saya. Jika Anda menginstal aplikasi ini dari sumber lain, harap hapus dan instal versi Play Store, F-Droid, atau GitHub.</string>
    <string name="onboarding_welcome_text_thanks">Terima Kasih Khusus</string>
    <string name="onboarding_welcome_text_thanks_paragraph">QuickWeather dimungkinkan oleh:\n - \u0020<a href="https://openweathermap.org/">OpenWeatherMap</a> dan <a href="https://open-meteo.com/">Open-Meteo</a>\n - \u0020<a href="https://github.com/amitjakhu/dripicons-weather">Dripicons - Weather</a> oleh Amit Jakhu\n - \u0020<a href="https://www.rainviewer.com/">RainViewer</a>\n - \u0020<a href="https://github.com/woxblom/DragListView">ListDragView</a> (<a href="https://github.com/woxblom/DragListView/blob/master/LICENSE">lisensi</a>) oleh Magnus Woxblom</string>
    <string name="onboarding_welcome_text_policies">Kebijakan</string>
    <string name="onboarding_welcome_text_policies_paragraph">- \u0020QuickWeather adalah perangkat lunak gratis yang dilisensikan di bawah <a href="https://www.gnu.org/licenses/">GNU General Public License</a>\n - \u0020Lihat <a href="https://tylerwilliamson.github.io/QuickWeather/PrivacyPolicy">Kebijakan Privasi</a></string>
